let arch = @map_arch(x86_64="x86_64")
let release = @fetch("https://api.github.com/repos/EpicGames/raddebugger/releases/latest")
let url = @json_value(release, "/assets/[name=raddbg.zip]/browser_download_url")
let digest = @json_value(release, "/assets/[name=raddbg.zip]/digest")

download url
verify digest
extract
discard "raddbg.com"
discard "raddbg.exe"
discard "raddbg.pdb"
discard "raddbg_markup.h"
discard "raddbg_readme.md"
discard "radlink.exe"
discard "radlink.pdb"
install exe "radbin.exe"
install pdb "radbin.pdb"
