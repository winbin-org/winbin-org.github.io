let arch = @map_arch(x86_64="x86_64", aarch64="aarch64", x86="i686")
let release = @fetch("https://api.github.com/repos/BurntSushi/ripgrep/releases/latest")
let tag = @json_value(release, "/tag_name")
let asset = "ripgrep-{tag}-{arch}-pc-windows-msvc"
let url = @json_value(release, "/assets/[name={asset}.zip]/browser_download_url")
let digest = @json_value(release, "/assets/[name={asset}.zip]/digest")

download url
verify digest
extract
discard "{asset}/COPYING"
discard "{asset}/LICENSE-MIT"
discard "{asset}/README.md"
discard "{asset}/UNLICENSE"
discard "{asset}/complete"
discard "{asset}/doc"
install exe "rg.exe" from "{asset}/rg.exe"
