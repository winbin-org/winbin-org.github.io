let arch = @map_arch(x86_64="x86_64", aarch64="aarch64", x86="x86")
let release = @fetch("https://api.github.com/repos/winbin-org/winbin/releases/latest")
let asset = "winbin-{arch}.zip"
let url = @json_value(release, "/assets/[name={asset}]/browser_download_url")
let digest = @json_value(release, "/assets/[name={asset}]/digest")

download url
verify digest
extract
install exe "winbin.exe"
if arch != "x86" | install pdb "winbin.pdb"
