let arch = @map_arch(x86_64="x86_64", aarch64="arm64", x86="i386")
let release = @fetch("https://api.github.com/repos/Kitware/CMake/releases/latest")
let tag = @json_value(release, "/tag_name")
let version = @match_text(tag, "v{*}")
let asset = "cmake-{version}-windows-{arch}"
let url = @json_value(release, "/assets/[name={asset}.zip]/browser_download_url")
let digest = @json_value(release, "/assets/[name={asset}.zip]/digest")

download url
verify digest
extract
install dir "cmake-{version}" from asset
install exelink "cmake.exe" -> "cmake-{version}/bin/cmake.exe"
install exelink "cpack.exe" -> "cmake-{version}/bin/cpack.exe"
install exelink "ctest.exe" -> "cmake-{version}/bin/ctest.exe"
