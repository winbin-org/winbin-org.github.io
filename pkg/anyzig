let arch = @map_arch(x86_64="x86_64", aarch64="aarch64", x86="x86")
let release = @fetch("https://api.github.com/repos/marler8997/anyzig/releases/latest")
let asset = "anyzig-{arch}-windows.zip"
let url = @json_value(release, "/assets/[name={asset}]/browser_download_url")
let digest = @json_value(release, "/assets/[name={asset}]/digest")

download url
verify digest
extract
install exe "zig.exe"
install pdb "zig.pdb"
