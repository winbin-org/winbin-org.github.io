let arch = @map_arch(x86_64="x86_64", aarch64="aarch64")
let release = @fetch("https://api.github.com/repos/ajeetdsouza/zoxide/releases/latest")
let tag = @json_value(release, "/tag_name")
let version = @match_text(tag, "v{*}")
let asset = "zoxide-{version}-{arch}-pc-windows-msvc.zip"
let url = @json_value(release, "/assets/[name={asset}]/browser_download_url")
let digest = @json_value(release, "/assets/[name={asset}]/digest")

download url
verify digest
extract
discard "CHANGELOG.md"
discard "LICENSE"
discard "README.md"
discard "completions"
discard "man"
install exe "zoxide.exe"
